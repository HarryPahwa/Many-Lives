# Environment variables (names only — no secrets). See TDD §19.
# Copy to .env and fill in. .env is git-ignored.

# --- Local canonical persistence ---
SQLITE_DB_PATH=dungeon.db          # tests override with an isolated temp database

# --- Model + embedding access (OpenRouter, OpenAI-compatible) ---
OPENROUTER_API_KEY=

# Model IDs per role [OPEN — confirm on the day]
MODEL_DRESSER=
MODEL_ADJUDICATOR=
MODEL_JEV=typesafe/jev-1.13
MODEL_NARRATOR=
MODEL_VERIFIER=
JEV_ENDPOINT=https://openrouter.ai/api/alpha/decisions
JEV_TIMEOUT_S=10

# Embedding model + dimension [OPEN]
EMBEDDING_MODEL=
EMBEDDING_DIMS=

# --- Toggles ---
USE_FAKE_MODELS=true               # true = use FakeModelClient, no real calls
DEBUG_ENDPOINTS=false              # true only in the demo environment
WORLD_GEN_FILE=config/world_gen.yaml
RUNTIME_RULES_FILE=config/runtime_rules.yaml

# --- Room visuals (optional; names only, no values) ---
# Master switch. Everything below is inert while this is false.
ENABLE_ROOM_VISUALS=false
AUTO_UPDATE_ROOM_VISUALS=false
IMAGE_CLIENT=auto
IMAGE_MODEL=
IMAGE_ASPECT_RATIO=
IMAGE_QUALITY=
IMAGE_OUTPUT_COMPRESSION=
IMAGE_TIMEOUT_S=
IMAGE_EDIT_INCLUDE_BASE=false
VISUAL_STORE=auto
VISUALS_DIR=
VISUAL_MAX_EDITS=
VISUAL_KEEP_REVISIONS=

# --- Speech (ElevenLabs). Leave the key blank to keep narration text-only. ---
ELEVENLABS_API_KEY=
# George, a premade narrative voice. Any voice id from your ElevenLabs account works.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
