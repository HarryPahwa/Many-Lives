# Environment variables (names only — no secrets). See TDD §19.
# Copy to .env and fill in. .env is git-ignored.

# --- MongoDB Atlas Sandbox ---
MONGODB_URI=
MONGODB_DB=dungeon                 # tests use dungeon_test

# --- Model + embedding access (OpenRouter, OpenAI-compatible) ---
OPENROUTER_API_KEY=

# Model IDs per role [OPEN — confirm on the day]
MODEL_DRESSER=
MODEL_ADJUDICATOR=
MODEL_NARRATOR=
MODEL_VERIFIER=

# Embedding model + dimension [OPEN — must match the vector index]
EMBEDDING_MODEL=
EMBEDDING_DIMS=

# --- Toggles ---
USE_FAKE_MODELS=true               # true = use FakeModelClient, no real calls
DEBUG_ENDPOINTS=false              # true only in the demo environment
BALANCE_FILE=config/balance.yaml

# --- Speech (ElevenLabs). Leave the key blank to keep narration text-only. ---
ELEVENLABS_API_KEY=
# George, a premade narrative voice. Any voice id from your ElevenLabs account works.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
